# User unit: schedule source checks, dbt build/docs and mart publication with Airflow.
# API/UI is reachable only on Tailscale; gridcase loads its secrets from the repo's .env.
[Unit]
Description=MarketCase Airflow warehouse scheduler

[Service]
Type=simple
Restart=on-failure
# Airflow idles near 1 GB and the dbt build (DuckDB capped at 1 GB) peaks at 1.3 GB.
MemoryMax=2600M
Nice=10
WorkingDirectory=%h/Documents/Claude/Projects/gridcase
ExecStart=%h/Documents/Claude/Projects/gridcase/orchestration/airflow/.venv/bin/airflow standalone
Environment=AIRFLOW_HOME=%h/.local/share/marketcase-airflow
Environment=AIRFLOW__CORE__DAGS_FOLDER=%h/Documents/Claude/Projects/gridcase/orchestration/airflow/dags
Environment=AIRFLOW__CORE__LOAD_EXAMPLES=False
Environment=AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
Environment=AIRFLOW__API__HOST=100.125.186.6
Environment=AIRFLOW__API__PORT=8711
Environment=AIRFLOW__API__WORKERS=1
# The DAG is one chain; the default 32 lets LocalExecutor fork up to 32 idle ~130 MB workers,
# which crept past MemoryMax every ~5 hours (OOM kills 2026-10-03).
Environment=AIRFLOW__CORE__PARALLELISM=2
Environment=AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://100.125.186.6:8711/execution/
Environment=GRIDCASE_ROOT=%h/Documents/Claude/Projects/gridcase
Environment=UV=%h/.local/bin/uv
# standalone starts its scheduler, API server and DAG processor as `airflow ...` subprocesses.
Environment=PATH=%h/Documents/Claude/Projects/gridcase/orchestration/airflow/.venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
