# User unit: save every Polymarket trade (v2 feed; after a restart it pages back to the last
# saved trade, so downtime up to a few days is filled, not lost). Writes raw gzip JSONL under
# data/raw/polymarket/; never opens the DuckDB store, so it cannot conflict with the server.
[Unit]
Description=GridCase Polymarket trades collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Claude/Projects/gridcase
# DuckDB shows times in the host zone; the app labels them UTC.
Environment=TZ=UTC
ExecStart=%h/.local/bin/uv run gridcase collect --interval 240
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=default.target
