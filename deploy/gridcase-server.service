# User unit: the MarketCase server (MCP at /mcp, JSON API at /api, UI at /). Install with
# deploy/install.sh. It is the only process that writes the DuckDB store: it loads collected
# trades every 5 minutes, runs the hourly watch and the follow-up checks itself.
# Bound to the Tailscale address; the public reaches it only through gridcase-tunnel.
# Secrets (.env: ANTHROPIC_API_KEY, GRIDCASE_API_TOKEN) are read by python-dotenv
# from WorkingDirectory; nothing is set here.
[Unit]
Description=MarketCase server (MCP + API + UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Claude/Projects/gridcase
# DuckDB shows times in the host zone; the app labels them UTC.
Environment=TZ=UTC
ExecStart=%h/.local/bin/uv run gridcase serve --host 100.125.186.6 --port 8710
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=default.target
